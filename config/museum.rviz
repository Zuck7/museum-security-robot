Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Tree Height: 700
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Color: 90; 90; 90
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Static Map
      Enabled: true
      Alpha: 0.8
      Color Scheme: map
      Topic:
        Value: /map
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        # CRITICAL: map_server publishes the map ONCE, latched, with
        # transient_local durability.  A Volatile subscriber connects but
        # never receives that historical sample, so the map panel stays blank
        # if RViz starts after Nav2.  This is the #1 "my map is missing" bug.
        Durability Policy: Transient Local
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: true
      Alpha: 0.45
      Color Scheme: costmap
      Topic:
        Value: /global_costmap/costmap
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: true
      Alpha: 0.65
      Color Scheme: costmap
      Topic:
        Value: /local_costmap/costmap
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Alpha: 1
      Description Topic:
        Value: /robot_description
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Size (m): 0.04
      Style: Points
      Color: 255; 60; 60
      Color Transformer: FlatColor
      Decay Time: 0
      Topic:
        Value: /scan
        Depth: 5
        History Policy: Keep Last
        # Sensor data from the gz bridge is Best Effort.  Asking for Reliable
        # here is a QoS mismatch and the display silently shows nothing.
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Enabled: true
      Color: 0; 200; 255
      Line Style: Lines
      Topic:
        Value: /plan
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Local Plan
      Enabled: true
      Color: 255; 230; 0
      Line Style: Lines
      Topic:
        Value: /local_plan
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Value: true
    - Class: rviz_default_plugins/PoseArray
      Name: AMCL Particle Cloud
      Enabled: true
      Shape: Arrow (Flat)
      Color: 0; 255; 120
      Alpha: 0.5
      Arrow Length: 0.2
      Topic:
        Value: /particle_cloud
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Value: true
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Color: 255; 255; 255
      Topic:
        Value: /local_costmap/published_footprint
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Marker Scale: 0.6
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 40; 42; 48
    Fixed Frame: map
    Frame Rate: 20
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Topic:
        Value: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: map
      Scale: 34
      X: 0
      Y: 0
      Angle: 0
      Invert Z Axis: false
Window Geometry:
  Height: 1000
  Width: 1700
  Displays:
    collapsed: false
