<?xml version="1.0"?>
<!--
  Museum security robot - differential drive base with a 2D lidar.

  Geometry contract (everything below depends on it):
    wheel radius             0.100 m  -> base_link origin sits 0.100 m above the floor
    wheel separation         0.450 m  (joints at y = +/-0.225)
    widest point             0.250 m  (wheel outer face) -> Nav2 robot_radius must be >= 0.25
    laser plane              0.230 m above the floor (base_link 0.100 + lidar_joint 0.130)

  If you change any of those, update config/nav2_params.yaml (robot_radius) and
  tools/generate_world.py (LIDAR_Z) to match.
-->
<robot name="security_bot">

  <!-- ===================================================================== -->
  <!-- CHASSIS                                                               -->
  <!-- ===================================================================== -->
  <!-- FIXED: visual and collision now share the same origin and dimensions.
       The old version had a 0.20 m tall visual centred on base_link, so the
       bottom of the shell sat exactly on the floor and clipped through it,
       while the collision shape was a different size at a different height.
       Mismatched visual/collision is the number one cause of "it looks fine
       but behaves strangely". -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.20" length="0.15"/>
      </geometry>
      <material name="gray">
        <color rgba="0.30 0.32 0.35 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.20" length="0.15"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="5.0"/>
      <!-- solid cylinder, r=0.20 h=0.15:  Ixx=Iyy=m(3r^2+h^2)/12, Izz=mr^2/2 -->
      <inertia ixx="0.059375" ixy="0" ixz="0"
               iyy="0.059375" iyz="0" izz="0.100000"/>
    </inertial>
  </link>

  <!-- A stub at floor level.  Not required by Nav2 (robot_base_frame is
       base_link) but it makes RViz measurements and future sensor mounting
       far less confusing. -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 -0.10" rpy="0 0 0"/>
  </joint>

  <!-- ===================================================================== -->
  <!-- DRIVE WHEELS                                                          -->
  <!-- ===================================================================== -->
  <!-- FIXED: both wheels now declare <axis xyz="0 1 0"/>.
       The old file gave the right wheel "0 -1 0".  gz-sim's DiffDrive system
       computes one target angular velocity per wheel and applies it about
       whatever axis the joint declares - it has no idea you flipped one.  A
       negated axis therefore spins the right wheel backwards on a forward
       command (the robot pirouettes) AND corrupts the wheel-odometry it
       publishes, which is what wrecked the SLAM map.  The mirrored joint
       origins already encode the left/right difference. -->

  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
      <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <!-- Inertia is expressed in the LINK frame, where the spin axis is Y,
           so Iyy = mr^2/2 and Ixx = Izz = m(3r^2+h^2)/12. -->
      <inertia ixx="0.002708" ixy="0" ixz="0"
               iyy="0.005000" iyz="0" izz="0.002708"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.225 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
      <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.002708" ixy="0" ixz="0"
               iyy="0.005000" iyz="0" izz="0.002708"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.225 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <!-- ===================================================================== -->
  <!-- CASTER                                                                -->
  <!-- ===================================================================== -->
  <!-- FIXED: the sphere now touches the ground plane instead of poking
       through it, and visual and collision are the same size.
       The wheels contact the floor at z = -0.10 relative to base_link, so a
       0.05 m sphere must be centred at z = -(0.10 - 0.05) = -0.05.
       The old file centred a sphere at z = -0.10 (bottom 0.05 m under the
       floor, pitching the robot), then "fixed" it by shrinking the collision
       to a 5 mm bead - which contacts on a near-point and makes the physics
       solver jitter. -->
  <link name="caster">
    <visual>
      <geometry><sphere radius="0.05"/></geometry>
      <material name="caster_gray"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <collision>
      <geometry><sphere radius="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <!-- solid sphere: I = 2mr^2/5 -->
      <inertia ixx="0.00025" ixy="0" ixz="0"
               iyy="0.00025" iyz="0" izz="0.00025"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="-0.15 0 -0.05" rpy="0 0 0"/>
  </joint>

  <!-- ===================================================================== -->
  <!-- LIDAR                                                                 -->
  <!-- ===================================================================== -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.055" length="0.06"/></geometry>
      <material name="blue"><color rgba="0 0.35 0.95 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.055" length="0.06"/></geometry>
    </collision>
    <inertial>
      <mass value="0.10"/>
      <inertia ixx="0.000126" ixy="0" ixz="0"
               iyy="0.000126" iyz="0" izz="0.000151"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.13" rpy="0 0 0"/>
  </joint>

  <!-- ===================================================================== -->
  <!-- SURFACE PROPERTIES                                                    -->
  <!-- ===================================================================== -->
  <gazebo reference="left_wheel">
    <mu1>1.0</mu1><mu2>1.0</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>
  <gazebo reference="right_wheel">
    <mu1>1.0</mu1><mu2>1.0</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>
  <!-- Near-frictionless caster so it slides instead of fighting turns. -->
  <gazebo reference="caster">
    <mu1>0.01</mu1><mu2>0.01</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>

  <!-- ===================================================================== -->
  <!-- DIFFERENTIAL DRIVE                                                    -->
  <!-- ===================================================================== -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.45</wheel_separation>
      <wheel_radius>0.10</wheel_radius>

      <odom_publish_frequency>50</odom_publish_frequency>

      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>

      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>

      <!-- DiffDrive can publish its own odom->base_link transform.  We leave
           it on a Gazebo-only topic that we deliberately do NOT bridge,
           because odom_tf_broadcaster.py publishes that transform on the ROS
           side instead.  Bridging both would put two publishers on /tf for
           the same edge, and tf2 would flip between them. -->
      <tf_topic>/model/security_bot/unused_tf</tf_topic>

      <!-- Acceleration limits keep MPPI's commands physically achievable. -->
      <max_linear_acceleration>1.5</max_linear_acceleration>
      <min_linear_acceleration>-1.5</min_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <min_angular_acceleration>-3.0</min_angular_acceleration>
    </plugin>

    <!-- Publishes wheel joint angles so robot_state_publisher can place the
         wheel frames in TF.  Without this the RobotModel display in RViz
         shows the wheels stuck at their zero pose. -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- ===================================================================== -->
  <!-- LIDAR SENSOR                                                          -->
  <!-- ===================================================================== -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <update_rate>10</update_rate>

      <!-- FIXED: without gz_frame_id, Gazebo stamps the scan with the scoped
           sensor name (security_bot/lidar_link/lidar).  That frame does not
           exist in the ROS TF tree, so every costmap silently drops every
           scan and the robot navigates blind.  Verify after launch with:
             ros2 topic echo /scan (check header.frame_id) -->
      <gz_frame_id>lidar_link</gz_frame_id>

      <ray>
        <scan>
          <horizontal>
            <!-- 270 rays is plenty for a 0.05 m costmap and roughly a third
                 the render cost of 360 - which matters a lot if you are on
                 software rendering inside a VM. -->
            <samples>270</samples>
            <resolution>1</resolution>
            <!-- max_angle stops one increment short of +pi so ray 0 and the
                 last ray are not the same bearing. -->
            <min_angle>-3.141593</min_angle>
            <max_angle>3.118322</max_angle>
          </horizontal>
        </scan>
        <range>
          <!-- 12 m comfortably spans the widest gallery (10.3 m), which is
               what AMCL needs to see enough wall to localise against. -->
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.008</stddev>
        </noise>
      </ray>

      <always_on>true</always_on>
      <!-- Drawing the rays in the GUI is pure GPU cost.  Turn it on only when
           you actually want the screenshot. -->
      <visualize>false</visualize>
    </sensor>
  </gazebo>

</robot>
