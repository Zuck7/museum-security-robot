<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="museum_world">
    <!-- Required Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Throttled Physics for smooth video recording -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>0.5</real_time_factor>
    </physics>

    <!-- Ambient World Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="centennial_robotics_museum">
      <static>true</static>

      <!-- High-Gloss Obsidian Floor -->
      <link name="floor">
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
        </collision>
      </link>

      <!-- Perimeter Walls (Sleek Matte White) -->
      <link name="north_wall"><pose>0 15 2 0 0 0</pose><visual name="v"><geometry><box><size>30.5 0.5 4</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient></material></visual><collision name="c"><geometry><box><size>30.5 0.5 4</size></box></geometry></collision></link>
      <link name="south_wall"><pose>0 -15 2 0 0 0</pose><visual name="v"><geometry><box><size>30.5 0.5 4</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient></material></visual><collision name="c"><geometry><box><size>30.5 0.5 4</size></box></geometry></collision></link>
      <link name="east_wall"><pose>15 0 2 0 0 0</pose><visual name="v"><geometry><box><size>0.5 30 4</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient></material></visual><collision name="c"><geometry><box><size>0.5 30 4</size></box></geometry></collision></link>
      <link name="west_wall"><pose>-15 0 2 0 0 0</pose><visual name="v"><geometry><box><size>0.5 30 4</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient></material></visual><collision name="c"><geometry><box><size>0.5 30 4</size></box></geometry></collision></link>

      <!-- ========================================== -->
      <!-- GRAND LOBBY & FOUNTAIN                     -->
      <!-- ========================================== -->
      <!-- Multi-tiered Gold Pillars -->
      <link name="pillar_1_base"><pose>-4 -6 0.25 0 0 0</pose><visual name="v"><geometry><box><size>1.2 1.2 0.5</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual><collision name="c"><geometry><box><size>1.2 1.2 0.5</size></box></geometry></collision></link>
      <link name="pillar_1"><pose>-4 -6 2 0 0 0</pose><visual name="v"><geometry><cylinder><radius>0.4</radius><length>4</length></cylinder></geometry><material><ambient>0.8 0.6 0.1 1</ambient><specular>1 1 1 1</specular></material></visual><collision name="c"><geometry><cylinder><radius>0.4</radius><length>4</length></cylinder></geometry></collision></link>
      
      <link name="pillar_2_base"><pose>4 -6 0.25 0 0 0</pose><visual name="v"><geometry><box><size>1.2 1.2 0.5</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual><collision name="c"><geometry><box><size>1.2 1.2 0.5</size></box></geometry></collision></link>
      <link name="pillar_2"><pose>4 -6 2 0 0 0</pose><visual name="v"><geometry><cylinder><radius>0.4</radius><length>4</length></cylinder></geometry><material><ambient>0.8 0.6 0.1 1</ambient><specular>1 1 1 1</specular></material></visual><collision name="c"><geometry><cylinder><radius>0.4</radius><length>4</length></cylinder></geometry></collision></link>

      <!-- Centerpiece Glowing Fountain Placeholder -->
      <link name="fountain_base"><pose>0 -3 0.1 0 0 0</pose><visual name="v"><geometry><cylinder><radius>2.5</radius><length>0.2</length></cylinder></geometry><material><ambient>0.3 0.3 0.3 1</ambient></material></visual><collision name="c"><geometry><cylinder><radius>2.5</radius><length>0.2</length></cylinder></geometry></collision></link>
      <link name="fountain_water"><pose>0 -3 0.15 0 0 0</pose><visual name="v"><geometry><cylinder><radius>2.3</radius><length>0.15</length></cylinder></geometry><material><ambient>0 0.5 0.8 0.8</ambient><emissive>0 0.3 0.6 1</emissive></material></visual></link>

      <!-- ========================================== -->
      <!-- EXHIBIT 1: The AI Supercomputer Wing       -->
      <!-- ========================================== -->
      <!-- Transparent Cyan Glass Enclosure -->
      <link name="ai_glass_wall"><pose>-6 -10 1.5 0 0 0</pose>
        <visual name="v">
          <geometry><box><size>0.2 10 3</size></box></geometry>
          <material><ambient>0.2 0.8 1 0.3</ambient><diffuse>0.2 0.8 1 0.3</diffuse><specular>1 1 1 1</specular></material>
          <transparency>0.6</transparency>
        </visual>
        <collision name="c"><geometry><box><size>0.2 10 3</size></box></geometry></collision>
      </link>
      
      <!-- Monolithic Mainframe -->
      <link name="mainframe"><pose>-11 -10 2 0 0 0</pose><visual name="v"><geometry><box><size>2 5 4</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient></material></visual><collision name="c"><geometry><box><size>2 5 4</size></box></geometry></collision></link>
      <link name="mainframe_glow_1"><pose>-9.9 -10 2 0 0 0</pose><visual name="v"><geometry><box><size>0.1 4 0.2</size></box></geometry><material><ambient>0 1 0.5 1</ambient><emissive>0 1 0.5 1</emissive></material></visual></link>
      <link name="mainframe_glow_2"><pose>-9.9 -10 2.5 0 0 0</pose><visual name="v"><geometry><box><size>0.1 4 0.2</size></box></geometry><material><ambient>0 1 0.5 1</ambient><emissive>0 1 0.5 1</emissive></material></visual></link>

      <!-- Industrial Cooling Towers (Beige/Brown Theme) -->
      <link name="cooling_fan_1"><pose>-12 -7 1.5 0 0 0</pose><visual name="v"><geometry><cylinder><radius>0.8</radius><length>3</length></cylinder></geometry><material><ambient>0.8 0.7 0.6 1</ambient></material></visual><collision name="c"><geometry><cylinder><radius>0.8</radius><length>3</length></cylinder></geometry></collision></link>
      <link name="cooling_accent_1"><pose>-12 -7 3.1 0 0 0</pose><visual name="v"><geometry><cylinder><radius>0.82</radius><length>0.3</length></cylinder></geometry><material><ambient>0.4 0.2 0.1 1</ambient></material></visual></link>
      
      <link name="cooling_fan_2"><pose>-12 -13 1.5 0 0 0</pose><visual name="v"><geometry><cylinder><radius>0.8</radius><length>3</length></cylinder></geometry><material><ambient>0.8 0.7 0.6 1</ambient></material></visual><collision name="c"><geometry><cylinder><radius>0.8</radius><length>3</length></cylinder></geometry></collision></link>
      <link name="cooling_accent_2"><pose>-12 -13 3.1 0 0 0</pose><visual name="v"><geometry><cylinder><radius>0.82</radius><length>0.3</length></cylinder></geometry><material><ambient>0.4 0.2 0.1 1</ambient></material></visual></link>

      <!-- ========================================== -->
      <!-- EXHIBIT 2: Renaissance Fine Art Gallery    -->
      <!-- ========================================== -->
      <!-- Floating Glowing Orb Display -->
      <link name="art_pedestal_1"><pose>9 10 0.5 0 0 0</pose><visual name="v"><geometry><cylinder><radius>0.6</radius><length>1</length></cylinder></geometry><material><ambient>1 1 1 1</ambient><specular>0.8 0.8 0.8 1</specular></material></visual><collision name="c"><geometry><cylinder><radius>0.6</radius><length>1</length></cylinder></geometry></collision></link>
      <link name="glowing_orb"><pose>9 10 1.5 0 0 0</pose><visual name="v"><geometry><sphere><radius>0.4</radius></sphere></geometry><material><ambient>1 0.2 0.5 1</ambient><emissive>1 0.2 0.5 1</emissive></material></visual><collision name="c"><geometry><sphere><radius>0.4</radius></sphere></geometry></collision></link>

      <!-- Glass Display Case -->
      <link name="glass_case_base"><pose>9 3 0.2 0 0 0</pose><visual name="v"><geometry><box><size>2 2 0.4</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual><collision name="c"><geometry><box><size>2 2 0.4</size></box></geometry></collision></link>
      <link name="glass_case_top"><pose>9 3 1.5 0 0 0</pose>
        <visual name="v">
          <geometry><box><size>1.8 1.8 2</size></box></geometry>
          <material><ambient>1 1 1 0.2</ambient></material>
          <transparency>0.8</transparency>
        </visual>
        <collision name="c"><geometry><box><size>1.8 1.8 2</size></box></geometry></collision>
      </link>
      <link name="ancient_relic"><pose>9 3 0.7 0 0 0</pose><visual name="v"><geometry><box><size>0.5 0.5 0.5</size></box></geometry><material><ambient>0.8 0.7 0.2 1</ambient></material></visual></link>

      <!-- ========================================== -->
      <!-- EXHIBIT 3: Prehistoric Dinosaur Bones      -->
      <!-- ========================================== -->
      <!-- Abstract T-Rex Skeleton Frame (Earthy Tones) -->
      <link name="spine"><pose>-8 9 2.5 0 1.57 0</pose><visual name="v"><geometry><cylinder><radius>0.15</radius><length>5</length></cylinder></geometry><material><ambient>0.7 0.6 0.5 1</ambient></material></visual><collision name="c"><geometry><cylinder><radius>0.15</radius><length>5</length></cylinder></geometry></collision></link>
      <link name="rib_1"><pose>-8 9 2.5 1.57 0 0</pose><visual name="v"><geometry><cylinder><radius>0.08</radius><length>2</length></cylinder></geometry><material><ambient>0.7 0.6 0.5 1</ambient></material></visual></link>
      <link name="rib_2"><pose>-7 9 2.5 1.57 0 0</pose><visual name="v"><geometry><cylinder><radius>0.08</radius><length>1.8</length></cylinder></geometry><material><ambient>0.7 0.6 0.5 1</ambient></material></visual></link>
      <link name="rib_3"><pose>-9 9 2.5 1.57 0 0</pose><visual name="v"><geometry><cylinder><radius>0.08</radius><length>2.2</length></cylinder></geometry><material><ambient>0.7 0.6 0.5 1</ambient></material></visual></link>
      <link name="skull_block"><pose>-5.5 9 2.5 0 0 0</pose><visual name="v"><geometry><box><size>1 1.2 1</size></box></geometry><material><ambient>0.6 0.5 0.4 1</ambient></material></visual><collision name="c"><geometry><box><size>1 1.2 1</size></box></geometry></collision></link>
      
      <!-- Rock Pedestal -->
      <link name="rock_base"><pose>-8 9 0.5 0 0 0</pose><visual name="v"><geometry><box><size>7 3 1</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient></material></visual><collision name="c"><geometry><box><size>7 3 1</size></box></geometry></collision></link>

    </model>
  </world>
</sdf>
